#!/usr/bin/env bash
# comfy-nodes — manage the custom nodes that survive a pod rebuild.
#
# Nodes you install through ComfyUI-Manager land on the pod's local disk, which
# is fast but ephemeral. This records them in /workspace/comfy_nodes.txt so they
# are restored on every future boot.

set -u
. /opt/scripts/node_manifest.sh

MANIFEST="$(cn_manifest_path)"

usage() {
  cat <<EOF
comfy-nodes — keep custom nodes across pod rebuilds

  comfy-nodes freeze         Record every node you have installed, at its exact
                             commit. Run this after installing via the Manager.
  comfy-nodes add <git-url> [sha]
                             Install a node now and record it.
  comfy-nodes list           Show what is currently pinned.
  comfy-nodes restore        Re-run the boot-time restore now.
  comfy-nodes status         Show which installed nodes are not yet recorded.

Manifest: $MANIFEST
Log:      $(cn_log_path)

Note: the 29 node packs bundled in the image are managed separately and are
never listed here. A node you rely on long-term is better added to the image's
own node_pins.txt and rebuilt — that costs nothing at boot.
EOF
}

cmd_freeze() {
  local lines header
  lines="$(cn_freeze_lines)"
  header="$(grep -E '^\s*#' "$MANIFEST" 2>/dev/null)"
  {
    [ -n "$header" ] && echo "$header"
    [ -n "$lines" ] && echo "$lines"
  } > "$MANIFEST.tmp"
  mv "$MANIFEST.tmp" "$MANIFEST"
  if [ -z "$lines" ]; then
    echo "No user-installed nodes found — nothing to record."
  else
    echo "Recorded $(echo "$lines" | wc -l | tr -d ' ') node(s) in $MANIFEST:"
    echo "$lines" | awk '{print "  " $1 "  " $3}'
  fi
}

cmd_add() {
  local url="${1:-}" sha="${2:-}" name
  [ -n "$url" ] || { echo "usage: comfy-nodes add <git-url> [sha]" >&2; exit 1; }
  name="$(cn_dirname_from_url "$url")"
  if cn_is_baked "$name"; then
    echo "$name is already baked into the image — nothing to do." >&2
    exit 1
  fi
  if cn_parse "$MANIFEST" | awk '{print $1}' | grep -qxF "$name"; then
    echo "$name is already pinned." >&2
    exit 1
  fi
  printf '%s %s %s\n' "$name" "$url" "${sha:-HEAD}" >> "$MANIFEST"
  echo "Pinned $name. Installing now..."
  bash /opt/scripts/restore_nodes.sh
  echo "Restart ComfyUI to load it."
}

cmd_list() {
  local out
  out="$(cn_parse "$MANIFEST")"
  if [ -z "$out" ]; then echo "Nothing pinned yet. Install nodes, then run: comfy-nodes freeze"; return; fi
  echo "$out" | awk '{printf "  %-34s %s\n", $1, $3}'
}

cmd_status() {
  local installed pinned missing
  installed="$(cn_freeze_lines | awk '{print $1}')"
  pinned="$(cn_parse "$MANIFEST" | awk '{print $1}')"
  missing="$(comm -23 <(echo "$installed" | sort -u) <(echo "$pinned" | sort -u) 2>/dev/null)"
  if [ -z "$installed" ]; then echo "No user-installed nodes."; return; fi
  if [ -z "$missing" ]; then
    echo "All installed nodes are recorded — nothing would be lost on rebuild."
  else
    echo "These are installed but NOT recorded, and will be lost on rebuild:"
    echo "$missing" | sed 's/^/  /'
    echo
    echo "Run: comfy-nodes freeze"
  fi
}

case "${1:-}" in
  freeze)  cmd_freeze ;;
  add)     shift; cmd_add "$@" ;;
  list)    cmd_list ;;
  restore) bash /opt/scripts/restore_nodes.sh ;;
  status)  cmd_status ;;
  ''|-h|--help|help) usage ;;
  *) echo "unknown command: $1" >&2; usage >&2; exit 1 ;;
esac
